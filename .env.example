# Copy this file to .env and fill in your own values.
# .env is git-ignored and must never be committed.

# --- AI (Stage 3) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Paths ---
EXCEL_PATH=data/internship_outreach.xlsx

# --- Logging ---
LOG_LEVEL=INFO

# --- Email safety limits (Stage 8). Present now so the shape is fixed early. ---
DAILY_SEND_LIMIT=10
BATCH_SIZE=5
SECONDS_BETWEEN_SENDS=30
DRY_RUN=true

# --- Gmail OAuth (Stage 8 -- leave blank until then) ---
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=http://localhost:8080/
