# Copy this file to .env and fill in your own values.
# .env is git-ignored and must never be committed.

# --- AI (Stage 3) ---
# Which provider to use: gemini (free tier) or openai (paid).
AI_PROVIDER=gemini

# Your API key for that provider.
#   gemini -> https://aistudio.google.com/apikey   (free, no card required)
#   openai -> https://platform.openai.com/api-keys (paid)
AI_API_KEY=

# Optional. Leave blank to use the provider default
# (gemini-flash-lite-latest, or gpt-4o-mini for openai).
AI_MODEL=

# Seconds to wait between companies during qualification. Free tiers cap
# requests per minute; a small pause avoids tripping that limit on a long
# run. Raise it if you still see rate-limit errors.
SECONDS_BETWEEN_AI_CALLS=4

# --- Paths ---
EXCEL_PATH=data/internship_outreach.xlsx

# --- Logging ---
LOG_LEVEL=INFO

# --- Email safety limits (Stage 8). Present now so the shape is fixed early. ---
DAILY_SEND_LIMIT=10
BATCH_SIZE=5
SECONDS_BETWEEN_SENDS=30
DRY_RUN=true

# --- Gmail OAuth (Stage 8 -- leave blank until then) ---
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=http://localhost:8080/
